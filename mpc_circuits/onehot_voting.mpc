from Compiler.types import sint, Array
from Compiler.library import print_ln, for_range
import sys

# sys.argv = ['./compile.py', 'onehot_voting', '<M_VOTERS>', '<K_CANDIDATES>']

# Leggiamo M_VOTERS dall'indice 2
if len(sys.argv) > 2 and sys.argv[2].isdigit():
    M_VOTERS = int(sys.argv[2])
else:
    M_VOTERS = 100

# Leggiamo K_CANDIDATES dall'indice 3
if len(sys.argv) > 3 and sys.argv[3].isdigit():
    K_CANDIDATES = int(sys.argv[3])
else:
    K_CANDIDATES = 4

# Tutto il resto del codice rimane identico:
tally = Array(K_CANDIDATES, sint)
tally.assign_all(0)

print_ln('--- Starting One-Hot MPC Tallying (Admitted Voters M=%s, Candidates K=%s) ---', M_VOTERS, K_CANDIDATES)

@for_range(M_VOTERS)
def _(voter_idx):
    @for_range(K_CANDIDATES)
    def _(c):
        vote_bit = sint.get_input_from(0)
        tally[c] += vote_bit

print_ln('\n--- MP-SPDZ FINAL TALLY ---')
@for_range(K_CANDIDATES)
def _(c):
    print_ln('Candidate %s: %s votes', c, tally[c].reveal())